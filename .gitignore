# =============================================================================
# SECRETS — never commit these
# =============================================================================
.env
.env.local
*.env
!.env.example

# Certificates and private keys (CSID material from onboarding)
*.pem
*.cer
*.crt
*.key
*.p12
*.pfx
certs/

# ZATCA SDK jar — download it from the Fatoora portal, don't commit it
*.jar

# =============================================================================
# INVOICE CHAIN STATE
# chain-store.json IS your invoice chain: it holds the last invoice hash, the
# counter (ICV), and the per-invoice UUIDs needed to issue credit/debit notes
# against earlier invoices.
#
# It is deliberately ignored here because committing it would mean merging
# chain state between machines/branches, which silently corrupts the chain.
# BACK IT UP separately (and move it to a database before production).
# =============================================================================
chain-store.json

# =============================================================================
# GENERATED OUTPUT
# =============================================================================
node_modules/
invoice_*_final.xml
ubl-output.xml
*.log

# Compiled Java
out/
*.class

