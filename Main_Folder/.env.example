# Path to the ZATCA SDK jar
ZATCA_SDK_JAR_PATH=/path/to/zatca-einvoicing-sdk-238-R3_4_8.jar

# PEM cert/key. For local testing only, you can point these at the sample
# pair bundled inside the SDK jar itself (extract cert/certificate.cer and
# PrivateKey.pem from the jar root) — NOT valid for real ZATCA submission.
# Once your CSID is issued, point these at the real files instead.
ZATCA_CERT_PATH=/path/to/cert.pem
ZATCA_PRIVATE_KEY_PATH=/path/to/private-key.pem
ZATCA_CERT_PASSWORD=

# Optional: pin a specific JDK 11-14 java binary to run the SDK subprocess
# with, matching ZATCA's documented supported JDK range. Leave unset to use
# whatever "java" resolves to on PATH (worked fine under JDK 21 in testing,
# but that's not a guarantee for your environment).
# ZATCA_JAVA_BIN=/usr/lib/jvm/java-11-openjdk-amd64/bin/java

ZATCA_SIGN_TIMEOUT_SECONDS=30
ZATCA_KEEP_TEMP_DIRS=false
PORT=8080
