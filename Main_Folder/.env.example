# =============================================================================
# NODE SERVICE (.env)
# The Java signing service has its OWN .env — see java-signing-service/.env.example
# =============================================================================

# --- Oracle Fusion ---
# Host root is enough; the SOAP client strips any /fscmRestApi suffix itself.
# e.g. https://your-instance.fa.em2.oraclecloud.com
ORACLE_BASE_URL=
ORACLE_USERNAME=
ORACLE_PASSWORD=

# --- BI Publisher report (SOAP: ExternalReportWSSService/runReport) ---
# Full catalog path to the report, ending in .xdo
BIP_REPORT_PATH=/Custom/Financials/ZATCA/zatca_report.xdo
# The report's parameter name for filtering to one invoice (case-sensitive —
# must match the report definition exactly, BIP ignores unknown names silently)
BIP_INVOICE_PARAM_NAME=P_INVOICE_NUMBER

# --- ZATCA gateway ---
# Sandbox / simulation / production base URL.
# NOTE: username/password here are the CSID binarySecurityToken and secret
# issued during onboarding, NOT your portal login. See zatca-pipeline.js.
ZATCA_BASE_URL=
ZATCA_USERNAME=
ZATCA_PASSWORD=

# --- Java signing service ---
ZATCA_SIGNING_SERVICE_URL=http://localhost:8080

# --- Seller identity (defaults are in config.js; override here if needed) ---
SELLER_VAT_NUMBER=300437621100003
SELLER_CR_NUMBER=2051034841
SELLER_NAME=Sumou Real Estate Company
SELLER_NAME_AR=شركة سمو العقارية

# --- Invoice chaining ---
# CRITICAL: this file IS your invoice chain. Losing it breaks the hash chain
# and makes credit/debit notes against older invoices impossible to issue.
# Back it up; move to a database before production (see chain-store.js).
ZATCA_CHAIN_STORE_PATH=./chain-store.json
